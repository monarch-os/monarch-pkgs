post_install() {
    echo "==========================================="
    echo "  monarch-lazyvpn installed successfully!"
    echo "==========================================="
    echo ""
    echo "Usage:"
    echo "  monarch-lazyvpn          - Launch the TUI VPN manager"
    echo "  monarch-lazyvpn-status   - Get current VPN status"
    echo ""
    echo "Configuration files are stored in:"
    echo "  ~/.config/monarch-lazyvpn/"
    echo ""
    echo "Waybar integration (optional):"
    echo "  Add to your modules in ~/.config/waybar/config:"
    echo ""
    echo "  \"custom/lazyvpn\": {"
    echo "    \"format\": \"{}\","
    echo "    \"interval\": 5,"
    echo "    \"exec\": \"monarch-lazyvpn-status\","
    echo "    \"on-click\": \"monarch-launch-floating-terminal-with-presentation monarch-lazyvpn\""
    echo "  }"
    echo ""
    echo "Keyboard shortcut (Hyprland):"
    echo "  Add to ~/.config/hypr/bindings.conf:"
    echo "  bindd = SUPER, V, LazyVPN, exec, monarch-launch-floating-terminal-with-presentation monarch-lazyvpn"
    echo ""
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ""
    echo "monarch-lazyvpn uninstalled."
    echo ""
    echo "Configuration files remain in:"
    echo "  ~/.config/monarch-lazyvpn/"
    echo ""
    echo "To remove completely:"
    echo "  rm -rf ~/.config/monarch-lazyvpn/"
    echo ""
}
