post_install() {
    echo "LazyVPN is available in the application launcher."
    echo "Run 'monarch install lazyvpn' for the Niri shortcut and Noctalia theme."
    echo "CLI commands and monarch-lazyvpn-status remain available."
}

post_upgrade() {
    post_install
    echo "Run 'monarch reconcile' to update an existing Monarch integration."
}

post_remove() {
    echo "LazyVPN removed. User profiles and credentials have been preserved."
}
