post_install() {
    echo "==========================================="
    echo "  monarch-lazyvpn installed successfully!"
    echo "==========================================="
    echo ""
    echo "Usage:"
    echo "  monarch-lazyvpn          - Launch the TUI VPN manager"
    echo "  monarch-lazyvpn-status   - Get current VPN status"
    echo ""
    echo "Configuration files are stored in:"
    echo "  ~/.config/monarch-lazyvpn/"
    echo ""
    echo "Noctalia bar integration (optional):"
    echo "  Add a CustomButton widget in ~/.config/noctalia/settings.json"
    echo "  (bar.widgets.left|center|right), then 'monarch restart noctalia':"
    echo ""
    echo "  {"
    echo "    \"id\": \"CustomButton\","
    echo "    \"icon\": \"shield\","
    echo "    \"parseJson\": true,"
    echo "    \"textCommand\": \"monarch-lazyvpn-status\","
    echo "    \"textIntervalMs\": 5000,"
    echo "    \"leftClickExec\": \"monarch-launch-floating-terminal-with-presentation monarch-lazyvpn\""
    echo "  }"
    echo ""
    echo "Keyboard shortcut (Niri):"
    echo "  Add to the binds block in ~/.config/niri/user.kdl,"
    echo "  then 'monarch refresh niri':"
    echo ""
    echo "  binds {"
    echo "      Mod+V hotkey-overlay-title=\"LazyVPN\" {"
    echo "          spawn \"monarch-launch-floating-terminal-with-presentation\" \"monarch-lazyvpn\";"
    echo "      }"
    echo "  }"
    echo ""
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ""
    echo "monarch-lazyvpn uninstalled."
    echo ""
    echo "Configuration files remain in:"
    echo "  ~/.config/monarch-lazyvpn/"
    echo ""
    echo "To remove completely:"
    echo "  rm -rf ~/.config/monarch-lazyvpn/"
    echo ""
}
