# Maintainer: Yoann ONO <contact@y0no.fr>

pkgname=monarch-lazyvpn
pkgver=0.2.0
pkgrel=3
pkgdesc="Native graphical WireGuard multi-provider VPN manager"
arch=('x86_64')
url="https://github.com/monarch-os/monarch-lazyvpn"
license=('MIT')
options=('!lto')
depends=(
    'wireguard-tools'
    'systemd-resolvconf'
    'nftables'
    'polkit'
    'libsecret'
    'gcc-libs'
    'openssl'
    'wayland'
    'libxkbcommon'
    'libxkbcommon-x11'
    'libxcb'
    'libglvnd'
    'fontconfig'
    'freetype2'
    'xdg-desktop-portal'
)
optdepends=('vulkan-driver: Vulkan rendering backend'
            'xdg-desktop-portal-gnome: file picker on Niri'
            'noctalia: live desktop palette integration')
makedepends=(
    'cargo'
    'git'
    'clang'
    'pkgconf'
)
source=("$pkgname-$pkgver::git+https://github.com/monarch-os/monarch-lazyvpn.git#tag=v$pkgver")
sha256sums=('SKIP')
backup=(
    'etc/sudoers.d/monarch-lazyvpn'
)
install=monarch-lazyvpn.install

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 "target/release/monarch-lazyvpn" "$pkgdir/usr/bin/monarch-lazyvpn"
    install -Dm755 "target/release/monarch-lazyvpn-status" "$pkgdir/usr/bin/monarch-lazyvpn-status"
    install -Dm755 "target/release/monarch-lazyvpn-gui" "$pkgdir/usr/bin/monarch-lazyvpn-gui"
    install -Dm644 "assets/monarch-lazyvpn.desktop" "$pkgdir/usr/share/applications/monarch-lazyvpn.desktop"
    install -Dm644 "assets/noctalia/lazyvpn.json" "$pkgdir/usr/share/monarch-lazyvpn/noctalia/lazyvpn.json"
    install -Dm644 "assets/flags/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/flag-icons-LICENSE"

    # Install sudoers configuration
    install -dm750 "$pkgdir/etc/sudoers.d"
    install -m440 "install/monarch-lazyvpn.sudoers" "$pkgdir/etc/sudoers.d/monarch-lazyvpn"

    # Install polkit rules
    install -Dm644 "install/50-monarch-lazyvpn.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-monarch-lazyvpn.rules"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
