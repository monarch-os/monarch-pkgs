# Maintainer: Yoann ONO <contact@y0no.fr>

pkgname=monarch-todo
pkgver=0.1.2
pkgrel=1
pkgdesc="Task manager and reminders for Monarch"
arch=('x86_64')
url="https://github.com/monarch-os/monarch-todo"
license=('MIT')
depends=('glibc' 'gcc-libs' 'systemd' 'libnotify' 'bash')
makedepends=(
    'cargo'
    'git'
    'make'
)
optdepends=(
    'monarch: Mod+T shortcut and bar integration'
    'noctalia>=5.3.0: native task panel'
    'python: desktop plugin activation'
)
source=("$pkgname-$pkgver::git+https://github.com/monarch-os/monarch-todo.git#tag=v$pkgver")
sha256sums=('SKIP')
install=monarch-todo.install

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # New releases own the backend and desktop payload in one transaction.
    # Keep the published 0.1.2 tag buildable until v0.2.0 is actually released.
    if [[ -f Makefile && -f noctalia/monarch-todo/plugin.toml ]]; then
        make DESTDIR="$pkgdir" PREFIX=/usr install
        return
    fi
    install -Dm755 "target/release/monarch-todo" "$pkgdir/usr/bin/monarch-todo"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
