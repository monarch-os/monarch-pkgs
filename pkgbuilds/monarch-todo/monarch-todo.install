post_install() {
  echo "monarch-todo: native panel and backend installed together."
  echo "As your desktop user: monarch-todo panel"
  echo "On Monarch: monarch install todo also configures Super+T."
  echo "Before removing: monarch-todo remove-desktop (or monarch remove todo)."
}

post_upgrade() {
  post_install
}

post_remove() {
  echo "monarch-todo uninstalled. Your task store is left untouched."
  echo "Remove the Monarch shortcut with: monarch remove todo"
}
