#!/bin/bash

set -euo pipefail

MONARCH_THEME_PATH="$HOME/.config/monarch/current/theme"
ZED_CONFIG_DIR="$HOME/.config/zed"
ZED_THEMES_DIR="$ZED_CONFIG_DIR/themes"
ZED_SETTINGS_PATH="$ZED_CONFIG_DIR/settings.json"
LOG_FILE="$HOME/.local/share/monzed/sync.log"
MONARCH_HOOKS_DIR="$HOME/.config/monarch/hooks"
THEME_SET_HOOK_DIR="$MONARCH_HOOKS_DIR/theme-set.d"
THEME_SET_HOOK="$THEME_SET_HOOK_DIR/monzed"
GENERATOR_SCRIPT="$HOME/.local/bin/monzed-generator.sh"
TEMPLATE_FILE="$HOME/.local/bin/monzed-theme.tpl"
HOOK_SOURCE="$HOME/.local/bin/monzed-hook"
INITIALIZED_MARKER="$HOME/.local/share/monzed/initialized"
THEME_NAME="Monzed"
THEME_FILENAME="monzed.json"

if [[ -f "/usr/bin/monzed-generator.sh" ]]; then
    GENERATOR_SCRIPT="/usr/bin/monzed-generator.sh"
fi

if [[ -f "/usr/share/monzed/monzed-theme.tpl" ]]; then
    TEMPLATE_FILE="/usr/share/monzed/monzed-theme.tpl"
fi

if [[ -f "/usr/share/monzed/monzed-hook" ]]; then
    HOOK_SOURCE="/usr/share/monzed/monzed-hook"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

info() {
    echo -e "${BLUE}[INFO]${NC} $*"
    log "INFO: $*"
}

success() {
    echo -e "${GREEN}[OK]${NC} $*"
    log "OK: $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
    log "WARN: $*"
}

error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
    log "ERROR: $*"
}

get_current_theme() {
    local theme=""
    local theme_name_path="$HOME/.config/monarch/current/theme.name"

    if [[ -f "$theme_name_path" ]]; then
        theme=$(tr -d '\n\r' < "$theme_name_path" 2>/dev/null || echo "")
    fi

    if [[ -z "$theme" && -L "$MONARCH_THEME_PATH" ]]; then
        local link_target
        link_target=$(readlink "$MONARCH_THEME_PATH" 2>/dev/null || echo "")
        if [[ -n "$link_target" ]]; then
            theme=$(basename "$link_target")
        fi
    fi

    echo "$theme"
}

generate_zed_theme() {
    local colors_toml="$MONARCH_THEME_PATH/colors.toml"
    local alacritty_toml="$MONARCH_THEME_PATH/alacritty.toml"
    local source_file="$colors_toml"
    local appearance="dark"

    if [[ ! -f "$GENERATOR_SCRIPT" ]]; then
        error "Theme generator script not found: $GENERATOR_SCRIPT"
        return 1
    fi

    if [[ ! -f "$colors_toml" ]]; then
        if [[ -f "$alacritty_toml" ]]; then
            warn "colors.toml not found, falling back to alacritty.toml"
            source_file="$alacritty_toml"
        else
            warn "Neither colors.toml nor alacritty.toml found in $MONARCH_THEME_PATH"
            return 1
        fi
    fi

    if [[ ! -f "$TEMPLATE_FILE" ]]; then
        error "Template file not found: $TEMPLATE_FILE"
        return 1
    fi

    if [[ -f "$MONARCH_THEME_PATH/light.mode" ]]; then
        appearance="light"
    fi

    mkdir -p "$ZED_THEMES_DIR"

    local generation_output
    if generation_output=$(bash "$GENERATOR_SCRIPT" "$source_file" "$ZED_THEMES_DIR" "$TEMPLATE_FILE" "$appearance" "$THEME_NAME" 2>&1); then
        log "Generation output: $generation_output"
        return 0
    else
        error "Failed to generate theme"
        log "Generation error: $generation_output"
        return 1
    fi
}

set_initial_theme_once() {
    if [[ -f "$INITIALIZED_MARKER" ]]; then
        return 0
    fi

    mkdir -p "$ZED_CONFIG_DIR"
    mkdir -p "$(dirname "$INITIALIZED_MARKER")"

    if [[ ! -f "$ZED_SETTINGS_PATH" ]]; then
        echo '{"theme": "'"$THEME_NAME"'"}' > "$ZED_SETTINGS_PATH"
        touch "$INITIALIZED_MARKER"
        info "Zed theme set to: $THEME_NAME"
        return 0
    fi

    if grep -q '"theme"' "$ZED_SETTINGS_PATH"; then
        local temp_file
        temp_file=$(mktemp)
        awk -v theme="$THEME_NAME" '
        BEGIN {
            in_theme_object = 0
            brace_count = 0
        }
        /"theme"[[:space:]]*:[[:space:]]*"[^"]*"/ {
            gsub(/"theme"[[:space:]]*:[[:space:]]*"[^"]*"/, "\"theme\": \"" theme "\"")
            print
            next
        }
        /"theme"[[:space:]]*:[[:space:]]*\{/ {
            gsub(/"theme"[[:space:]]*:[[:space:]]*\{.*/, "\"theme\": \"" theme "\",")
            in_theme_object = 1
            brace_count = 1
            print
            next
        }
        in_theme_object == 1 {
            brace_count += gsub(/\{/, "{")
            brace_count -= gsub(/\}/, "}")
            if (brace_count <= 0) {
                in_theme_object = 0
            }
            next
        }
        { print }
        ' "$ZED_SETTINGS_PATH" > "$temp_file"

        mv "$temp_file" "$ZED_SETTINGS_PATH"
        touch "$INITIALIZED_MARKER"
        info "Zed theme set to: $THEME_NAME"
        return 0
    fi

    local temp_file
    temp_file=$(mktemp)
    awk -v theme="$THEME_NAME" '
    {
        lines[NR] = $0
    }
    END {
        close_index = 0
        for (i = NR; i >= 1; i--) {
            if (lines[i] ~ /^[[:space:]]*}[[:space:]]*$/) {
                close_index = i
                break
            }
        }

        if (close_index == 0) {
            for (i = 1; i <= NR; i++) print lines[i]
            print "  \"theme\": \"" theme "\""
            exit
        }

        prev = close_index - 1
        while (prev > 0 && lines[prev] ~ /^[[:space:]]*$/) prev--
        if (prev > 0 && lines[prev] !~ /,[[:space:]]*$/) {
            lines[prev] = lines[prev] ","
        }

        for (i = 1; i < close_index; i++) print lines[i]
        print "  \"theme\": \"" theme "\""
        print lines[close_index]
        for (i = close_index + 1; i <= NR; i++) print lines[i]
    }
    ' "$ZED_SETTINGS_PATH" > "$temp_file"

    mv "$temp_file" "$ZED_SETTINGS_PATH"
    touch "$INITIALIZED_MARKER"
    info "Zed theme set to: $THEME_NAME"
}

setup_monarch_hook() {
    if [[ ! -d "$MONARCH_HOOKS_DIR" ]]; then
        error "Monarch hooks directory not found: $MONARCH_HOOKS_DIR"
        error "Is Monarch installed and configured for the current user?"
        return 1
    fi

    mkdir -p "$THEME_SET_HOOK_DIR"

    if [[ -f "$HOOK_SOURCE" ]]; then
        install -m 0755 "$HOOK_SOURCE" "$THEME_SET_HOOK"
    else
        cat > "$THEME_SET_HOOK" << 'EOF'
#!/bin/bash
# monzed theme-set hook — regenerates the Zed theme on each Monarch theme switch.
exec monzed set "$1"
EOF
        chmod 755 "$THEME_SET_HOOK"
    fi

    success "Monarch hook installed: $THEME_SET_HOOK"
}

setup_user() {
    info "Setting up monzed for user: $USER"

    mkdir -p "$ZED_THEMES_DIR"

    setup_monarch_hook
    sync_theme

    success "Setup complete — Zed will now follow your Monarch theme."
}

sync_theme() {
    local current_theme
    current_theme=$(get_current_theme)

    if [[ -z "$current_theme" ]]; then
        warn "Could not determine current Monarch theme"
    else
        info "Current Monarch theme: $current_theme"
    fi

    local theme_file="$ZED_THEMES_DIR/$THEME_FILENAME"
    rm -f "$theme_file"

    if generate_zed_theme; then
        if [[ -f "$theme_file" ]]; then
            success "Generated Zed theme: $theme_file"
        else
            warn "Generation reported success but file is missing: $theme_file"
            return 1
        fi
    else
        return 1
    fi
}

set_theme_from_name() {
    local theme_name="$1"

    if [[ -z "$theme_name" ]]; then
        error "No theme name provided"
        return 1
    fi

    info "Updating Zed theme for Monarch theme: $theme_name"
    generate_zed_theme
}

usage() {
    cat << EOF
monzed — Live theme switching for Zed in Monarch

USAGE:
    monzed <command> [args]

COMMANDS:
    setup           Install the monarch theme-set hook and run an initial sync
    sync            Regenerate the Zed theme from the current Monarch theme
    set <name>      Regenerate the Zed theme (called by the monarch hook)
    -h, --help      Show this help

EXAMPLES:
    monzed setup
    monzed sync
    monzed set tokyo-night
EOF
}

main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    local command=""
    local theme_arg=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            sync) command="sync"; shift ;;
            set)
                command="set"
                shift
                theme_arg="${1:-}"
                [[ $# -gt 0 ]] && shift
                ;;
            setup) command="setup"; shift ;;
            -h|--help) usage; exit 0 ;;
            *)
                error "Unknown argument: $1"
                usage
                exit 1
                ;;
        esac
    done

    set_initial_theme_once

    case "$command" in
        sync) sync_theme ;;
        set)
            if [[ -z "$theme_arg" ]]; then
                error "Theme name required for 'set' command"
                exit 1
            fi
            set_theme_from_name "$theme_arg"
            ;;
        setup) setup_user ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
