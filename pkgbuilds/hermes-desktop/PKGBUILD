# Maintainer: Monarch Linux

pkgname=hermes-desktop
pkgver=2026.9.7
pkgrel=1
pkgdesc='Native desktop shell for Hermes Agent'
arch=('x86_64')
url='https://github.com/NousResearch/hermes-agent'
license=('MIT')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'curl' 'gcc'
         'gdk-pixbuf2' 'git' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme'
         'libcups' 'libdrm' 'libglvnd' 'libnotify' 'libsecret' 'libx11'
         'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
         'libxkbcommon' 'libxrandr' 'make' 'mesa' 'nodejs' 'npm' 'nspr'
         'nss' 'pango' 'python' 'systemd-libs' 'util-linux' 'xdg-utils')
makedepends=('imagemagick')
optdepends=('monarch: desktop and terminal integration')
options=('!strip' '!debug')

# The build stamp must name Hermes, not the enclosing package repository.
_commit=2237be355906fbe6065ce1815711eee52b2d646e
_packaging=fde1581fd36780ae6259468d6b65a2cab22989a3
_assets="https://raw.githubusercontent.com/omacom-io/omarchy-pkgs/${_packaging}/pkgbuilds/hermes-desktop"
source=("${pkgname}-${pkgver}.tar.gz::https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/tags/v${pkgver}"
        "${_assets}/hermes-desktop.sh"
        "${_assets}/hermes-desktop.desktop"
        "${_assets}/hermes-desktop.png"
        "${_assets}/runtime.patch"
        "${_assets}/runtime-test.py")
sha256sums=('907c2a72db1c5dd637ea8eeae97f4cb5b32cef615c17258f6b190924ec5bf688'
            '1c513d0376fbd0c433005bd591d89d04361ecda6335bedf0fec975d80ca71037'
            '3ef685bfcf366776b025d26c37d32854d8d4aa2023b2bd07c8e08b001ef1e8c4'
            'd60d164e24fdcf6532133b8ea43c77a201e4b9e9dbc396187b58d51d8590ef52'
            '9d5015d1be762a901f8f64319981ae862e9852fa5cb9a22a2ba1e691f90430a2'
            '9587f495b2d76a7b67b55f2edf4c92b15152a8b08415008d3c20d428ba77f56c')

build() {
  cd "${srcdir}/hermes-agent-${pkgver}"
  export GITHUB_SHA="${_commit}"
  export GITHUB_REF_NAME="main"
  npm ci
  cd apps/desktop
  npm run pack
}

check() {
  python "${srcdir}/runtime-test.py" "${srcdir}/hermes-agent-${pkgver}" \
    "${srcdir}/runtime.patch" "${srcdir}/hermes-desktop.sh"
}

package() {
  local root="${srcdir}/hermes-agent-${pkgver}" size
  install -dm755 "${pkgdir}/opt/${pkgname}"
  cp -a "${root}/apps/desktop/release/linux-unpacked/." "${pkgdir}/opt/${pkgname}/"
  install -Dm755 "${srcdir}/hermes-desktop.sh" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${root}/scripts/install.sh" "${pkgdir}/usr/share/${pkgname}/install.sh"
  install -Dm644 "${srcdir}/hermes-desktop.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 "${srcdir}/hermes-desktop.png" "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${pkgname}.png"
  for size in 512 256 128 64 48; do
    magick "${srcdir}/hermes-desktop.png" -resize "${size}x${size}" "${srcdir}/icon-${size}.png"
    install -Dm644 "${srcdir}/icon-${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${pkgname}.png"
  done
  install -Dm644 "${root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${pkgdir}/opt/${pkgname}/LICENSE.electron.txt" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  chmod 0755 "${pkgdir}/opt/${pkgname}/chrome-sandbox"
}
