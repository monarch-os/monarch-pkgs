# Maintainer: Yoann ONO <contact@y0no.fr>

pkgname=monarch-dns
pkgver=0.1.0
pkgrel=1
pkgdesc="Show or set the system DNS provider, with a passwordless grant for the stock three"
arch=('any')
url="https://github.com/monarch-os/monarch"
license=('MIT')
depends=('networkmanager' 'systemd')
optdepends=('monarch: the network panel that toggles this with one click')
source=('monarch-dns' 'monarch-dns.sudoers')
sha256sums=('15ab86ccff08507b0e7ae26236f3b1c0a25f597be972fad49a6b1bbdf935c26f'
            'ebb6e57ef1261f094e75f6f5eb75c6d9a6129f9005f18b9c4fe79df0f6895abc')

# A malformed drop-in makes sudo refuse the whole sudoers set, which locks the
# machine out of root. Catch it here rather than on the user's disk.
check() {
    visudo -c -f monarch-dns.sudoers
}

package() {
    install -Dm755 monarch-dns "$pkgdir/usr/bin/monarch-dns"

    # 0440 and root:root, or sudo refuses to read the file at all and every
    # `sudo` on the machine starts complaining about it.
    install -Dm440 -o root -g root monarch-dns.sudoers "$pkgdir/etc/sudoers.d/monarch-dns"
}
