#!/bin/bash

# Reloading IPU7 modules during resume can destabilize kernel power management,
# so recover through camera-init and v4l2-relayd instead.

case "$1" in
  pre)
    systemctl stop v4l2-relayd@ipu7.service 2>/dev/null || true
    ;;
  post)
    systemd-run --no-block --unit=camera-resume bash -c '
      systemctl restart camera-init.service 2>/dev/null || true
      systemctl reset-failed v4l2-relayd@ipu7.service 2>/dev/null || true
      systemctl start v4l2-relayd@ipu7.service 2>/dev/null || true
    '
    ;;
esac
exit 0
