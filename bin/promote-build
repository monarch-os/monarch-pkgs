#!/bin/bash
# Promote packages from build-output to pkgs.monarchlinux.com

set -e

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"

print_header "Promote Build to Production"

# Parse arguments
DRY_RUN=false
while [[ $# -gt 0 ]]; do
  case $1 in
  --arch)
    ARCH="$2"
    update_arch_paths
    shift 2
    ;;
  --dry-run)
    DRY_RUN=true
    shift
    ;;
  -h | --help)
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --arch <arch>  Target architecture (x86_64 or aarch64, default: x86_64)"
    echo "  --dry-run      Show what would be copied without copying"
    echo "  -h, --help     Show this help message"
    echo ""
    echo "This script promotes packages from build-output/ to pkgs.monarchlinux.com/"
    exit 0
    ;;
  *)
    print_error "Unknown option: $1"
    exit 1
    ;;
  esac
done

print_info "Build output: $BUILD_OUTPUT_DIR"
print_info "Final output: $REPO_DIR"

# Check if build output exists
if [[ ! -d "$BUILD_OUTPUT_DIR" ]]; then
  print_error "Build output directory not found: $BUILD_OUTPUT_DIR"
  print_warning "Run bin/repo build first"
  exit 1
fi

if [[ $DRY_RUN != true ]]; then
  exec {promote_lock}<"$BUILD_OUTPUT_DIR"
  if ! flock -n "$promote_lock"; then
    print_error "Another promotion is already using this build directory."
    exit 1
  fi
fi

cd "$BUILD_OUTPUT_DIR"
shopt -s nullglob
PACKAGE_FILES=()
SIGNATURE_ONLY=()
for pkg_file in *.pkg.tar.*; do
  [[ $pkg_file == monarch-build.db* || $pkg_file == monarch-build.files* ]] && continue
  if [[ $pkg_file == *.sig ]]; then
    if [[ ! -e ${pkg_file%.sig} && ! -L ${pkg_file%.sig} ]]; then
      SIGNATURE_ONLY+=("$pkg_file")
    fi
  else
    PACKAGE_FILES+=("$pkg_file")
  fi
done

if (( ${#PACKAGE_FILES[@]} == 0 && ${#SIGNATURE_ONLY[@]} == 0 )); then
  print_warning "No packages found in build output"
  exit 0
fi

print_info "Found ${#PACKAGE_FILES[@]} package(s) and ${#SIGNATURE_ONLY[@]} signature-only file(s) to process"

if [[ "$DRY_RUN" == true ]]; then
  print_warning "DRY RUN MODE - No files will be copied"
  echo ""
  print_info "Packages that would be promoted:"
  for pkg_file in *.pkg.tar.*; do
    [[ $pkg_file == monarch-build.db* || $pkg_file == monarch-build.files* ]] && continue
    echo "  - $pkg_file"
  done
else
  echo ""
  mkdir -p "$REPO_DIR"

  echo "==> Verifying all packages have signatures..."
  MISSING_SIGS=()
  for pkg_file in "${PACKAGE_FILES[@]}"; do
    if [[ ! -f $pkg_file || -L $pkg_file || -L $pkg_file.sig ]]; then
      print_error "Refusing an unsafe package or signature: $pkg_file"
      exit 1
    fi

    if [[ ! -f "$pkg_file.sig" ]]; then
      MISSING_SIGS+=("$pkg_file")
    fi
  done

  if [[ ${#MISSING_SIGS[@]} -gt 0 ]]; then
    echo ""
    print_error "ERROR: The following packages are missing signatures:"
    for pkg in "${MISSING_SIGS[@]}"; do
      echo "  - $pkg (missing $pkg.sig)"
    done
    echo ""
    print_error "All packages must be signed before promotion!"
    echo ""
    echo "To fix this, run:"
    echo "  bin/repo sign --arch $ARCH"
    exit 1
  fi

  echo "==> Checking for existing files in production..."
  CONFLICTS=()
  ALREADY_PUBLISHED=()
  TO_PROMOTE=()
  STAGED_CLEANUP=()
  plan_signature_recovery() {
    local package="$1"
    if [[ ! -f $package.sig || -L $package.sig || ! -f $REPO_DIR/$package || -L $REPO_DIR/$package ]]; then
      CONFLICTS+=("$package.sig (staged signature or published archive is missing or unsafe)")
      return 1
    fi
    if [[ -e $REPO_DIR/$package.sig || -L $REPO_DIR/$package.sig ]] &&
      [[ ! -f $REPO_DIR/$package.sig || -L $REPO_DIR/$package.sig ]]; then
      CONFLICTS+=("$package.sig (unsafe published signature)")
      return 1
    fi
    # Without a staged archive, the signature must prove which published bytes it covers.
    if ! gpg --batch --no-auto-key-retrieve --verify "$package.sig" "$REPO_DIR/$package" >/dev/null 2>&1; then
      CONFLICTS+=("$package.sig (cannot verify against the published archive; check signature and signing key)")
      return 1
    fi
    if [[ -f $REPO_DIR/$package.sig ]]; then
      ALREADY_PUBLISHED+=("$package")
      STAGED_CLEANUP+=("$package.sig")
    else
      TO_PROMOTE+=("$package.sig")
    fi
  }

  for pkg_file in "${PACKAGE_FILES[@]}"; do

    if [[ -e $REPO_DIR/$pkg_file || -L $REPO_DIR/$pkg_file ]]; then
      if [[ -f $REPO_DIR/$pkg_file && ! -L $REPO_DIR/$pkg_file ]] &&
        cmp -s -- "$pkg_file" "$REPO_DIR/$pkg_file"; then
        if [[ -f $REPO_DIR/$pkg_file.sig && ! -L $REPO_DIR/$pkg_file.sig ]]; then
          ALREADY_PUBLISHED+=("$pkg_file")
          STAGED_CLEANUP+=("$pkg_file" "$pkg_file.sig")
        else
          if plan_signature_recovery "$pkg_file"; then
            STAGED_CLEANUP+=("$pkg_file")
          fi
        fi
      else
        CONFLICTS+=("$pkg_file (different contents or unsafe destination)")
      fi
    elif [[ -e $REPO_DIR/$pkg_file.sig || -L $REPO_DIR/$pkg_file.sig ]]; then
      CONFLICTS+=("$pkg_file.sig (signature exists without its package)")
    else
      TO_PROMOTE+=("$pkg_file" "$pkg_file.sig")
    fi
  done

  for signature in "${SIGNATURE_ONLY[@]}"; do
    plan_signature_recovery "${signature%.sig}" || true
  done

  if [[ ${#CONFLICTS[@]} -gt 0 ]]; then
    echo ""
    print_error "ERROR: The following packages conflict with production:"
    for conflict in "${CONFLICTS[@]}"; do
      echo "  - $conflict"
    done
    echo ""
    print_error "Refusing to overwrite or publish unverifiable files. Bump pkgrel for changed package contents."
    exit 1
  fi

  for pkg_file in "${ALREADY_PUBLISHED[@]}"; do
    print_info "Already published with identical contents: $pkg_file"
  done

  print_info "Moving packages to production..."
  MOVED=0
  for pkg_file in "${TO_PROMOTE[@]}"; do
    if mv -v -T --no-clobber -- "$pkg_file" "$REPO_DIR/$pkg_file" && [[ ! -e $pkg_file ]]; then
      MOVED=$((MOVED + 1))
    else
      print_error "Failed to move $pkg_file"
      exit 1
    fi
  done

  echo ""
  print_success "Promoted $MOVED file(s) to pkgs.monarchlinux.com"
  
  # Cleanup build directory after successful promotion
  print_info "Cleaning up build directory..."
  # Preserve the staged proof until every planned move succeeds, so failures remain retryable.
  if (( ${#STAGED_CLEANUP[@]} > 0 )); then
    rm -- "${STAGED_CLEANUP[@]}"
  fi
  rm -f -- monarch-build.db* monarch-build.files*
  print_success "Build directory cleaned"
fi
